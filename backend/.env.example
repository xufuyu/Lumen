# 拾光 · Lumen 运行环境变量
# 复制此文件为 .env 并按需修改。.env 不会进 git。

# ── 中继（Chat LLM + ASR 均通过 Cloudflare Worker 中转） ──
RELAY_BASE_URL=https://advx.fzxufuyu.eu.org/v1
RELAY_API_KEY=sk-relay
ASR_RELAY_WS_URL=wss://advx.fzxufuyu.eu.org/v1/realtime/asr/stream

# ── 中继 TLS 策略（自建中继时使用） ──
# 三种模式，优先级 INSECURE > CA_BUNDLE > 默认系统 CA：
#   1. 使用公网 CA 签发的证书（默认）→ 两个都留空
#   2. 自签名 CA 且证书 SAN 里正确写了目标 IP/域名 → 只填 RELAY_CA_BUNDLE
#   3. IP 直连自签证书（SAN 没写 IP，或懒得配）→ 只把 RELAY_TLS_INSECURE 设 true
# 注意：INSECURE=true 会绕过所有 TLS 校验（含 hostname），仅用于内网/开发
RELAY_CA_BUNDLE=
RELAY_TLS_INSECURE=false

# ── LLM 模型（由中继路由到 DeepSeek） ──
MODEL_PRO=deepseek-v4-flash
MODEL_FLASH=deepseek-v4-flash

# ── 数据库（默认 SQLite 本地文件） ──
DATABASE_URL=sqlite+aiosqlite:///data/adventurex.db

# ── 自动处理（记录提交后是否立刻 LLM 整理） ──
AUTO_PROCESS=true
